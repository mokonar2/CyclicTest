<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_gravity="center">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Расчёт циклических испытаний"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Выберите пружину"
            android:textSize="20sp"
            android:gravity="center"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/btnSpring003"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Пружина 003\nАмплитуда 21 мм"
            android:textSize="22sp"
            android:padding="24dp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnSpring004"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Пружина 004\nАмплитуда 22 мм"
            android:textSize="22sp"
            android:padding="24dp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnSpring005"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Пружина 005\nАмплитуда 22 мм"
            android:textSize="22sp"
            android:padding="24dp" />

    </LinearLayout>
</ScrollView>
